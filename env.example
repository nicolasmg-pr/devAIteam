# Database
DATABASE_URL=your_db_url_here

# Server
PORT=3000
NODE_ENV=development

# API Keys
OPENWEATHERMAP_API_KEY=your_api_key_here
CLOUD_CONVERT_API_KEY=your_api_key_here
STITCH_API_KEY=your_stitch_api_key_here

# CORS
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# ──────────────────────────────────────────────────────────────────────────
# devAIteam platform (the multi-agent pipeline itself — copy to .env)
# ──────────────────────────────────────────────────────────────────────────

# LLM provider selection:
#   openai            -> always use cloud OpenAI (requires OPENAI_API_KEY)
#   mlx / local       -> always use the local MLX endpoint
#   (unset)           -> cloud iff a real OPENAI_API_KEY is present, else MLX
LLM_PROVIDER=

# Cloud LLM (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
OPENAI_REASONING_MODEL=o3-mini

# Local MLX endpoint (defaults shown)
MLX_BASE_URL=http://localhost:8000/v1
MLX_MODEL=Qwen3.6-35B-A3B-UD-MLX-4bit

# LLM client tuning
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2

# GitHub integration (Reviewer PRs + `devAIteam rm --all`)
GITHUB_OWNER=your_github_username_here
GITHUB_REPO=your_github_repo_name_here
GITHUB_PERSONAL_ACCESS_TOKEN=your_github_pat_token

# Cloud deploy tokens (optional)
FLY_API_TOKEN=your_fly_token_here
RAILWAY_TOKEN=your_railway_token_here
RENDER_API_KEY=your_render_api_key_here

# Path overrides (optional; default to the repo root and repo_root/output)
# DEVAITEAM_ROOT=
# DEVAITEAM_OUTPUT_DIR=